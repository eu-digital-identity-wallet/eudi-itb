<?xml version="1.0" encoding="UTF-8"?>
<testcase id="issue_pid_sdjwt_credentialoffer_untrusted_certificate" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <gitb:name>Issuance of PID in sd-jwt format using the Issuer-initiated Authorization Code Flow with an untrusted issuer certificate</gitb:name>
        <gitb:version>1.0</gitb:version>
        <gitb:description>This test case verifies that it is not possible to issue a PID using the Issuer-initiated Authorization Code Flow when the PID provider’s certificate is not trusted</gitb:description>
        <gitb:specification>
            <gitb:reference>Issuance_5</gitb:reference>
        </gitb:specification>
        <gitb:documentation><![CDATA[
            <h4>Preconditions</h4>
            <ol style="list-style-type: lower-alpha;">
            <li>The wallet trusts the issuer of the credential issuer’s access certificate</li>
            <li>The wallet trusts the issuer of the credential issuer’s registration certificate</li>
            </ol>
            <h4>Test steps</h4>
            <ol>
            <li>The user starts the test case in ITB</li>
            <li>The user scans the QR code with their wallet</li>
            <li>The user completes the issuance process</li>
            <li>ITB records the test execution result</li>
            </ol>
            <h4>Expected results</h4>
            <ol>
            <li>ITB displays a popup with a QR code containing the credential offer</li>
            <li>The website of the issuer opens</li>
            <li>The wallet rejects the issuance of the credential</li>
            <li>The test execution result appears on the ITB screen</li>
            </ol>
        ]]></gitb:documentation>
    </metadata>
    <actors>
        <gitb:actor id="simulatedCredentialOffer" name="Simulated Credential Offer"/>
        <gitb:actor id="issuer" name="Issuer" />
        <gitb:actor id="wallet" name="Wallet" role="SUT"/>
    </actors>
    <steps>
        <verify handler="ExpressionValidator" desc="Verify if Issuer Backend Address is set" stopOnError="true">
            <input name="expression">$DOMAIN{issuerBackendAddress} != ""</input>
            <input name="successMessage">"The Issuer Backend Address is defined."</input>
            <input name="failureMessage">"The Issuer Backend Address is not defined."</input>
        </verify>

        <assign to="credentialOfferSetupURL">$DOMAIN{issuerBackendAddress} || "/credential_offer2"</assign>
        <assign to="credentialIssuanceLogsURL">$DOMAIN{issuerBackendAddress} || "/logs"</assign>
        <assign to="credentialConfigurationId">"eu.europa.ec.eudi.pid_vc_sd_jwt_av2"</assign>
        
        <log>$credentialOfferSetupURL || "?credential_configuration_id=" || $credentialConfigurationId</log>
        
        <!--Making an HTTP Request to the Issuer's Credential Offer Endpoint -->
        <assign to="httpHeaders{Content-Type}">"application/json"</assign>
        <send id="credentialOfferRequest" desc="Send request to generate Credential Offer for PID issuance (SD-JWT)" handler="HttpMessagingV2" from="simulatedCredentialOffer" to="issuer" stopOnError="true">
            <input name="uri">$credentialOfferSetupURL || "?credential_configuration_id=" || $credentialConfigurationId</input>
            <input name="method">"GET"</input>
            <input name="headers">$httpHeaders</input>
        </send>

        <verify handler="ExpressionValidator" desc="Verify http status code of Credential Offer setup request" stopOnError="true">
            <input name="expression">$credentialOfferRequest{response}{status} = "200"</input>
            <input name="successMessage">"The received http status code was 200."</input>
            <input name="failureMessage">"The received http status code was not 200."</input>
        </verify>

        <!--Process the Credential Offer setup response-->
        <assign to="credentialOfferResponse" source="$credentialOfferRequest{response}{body}" type="string"/> 
        <process handler="JsonPathProcessor" operation="process" output="sessionID" stopOnError="true">
           <input name="content">$credentialOfferResponse</input>
           <input name="expression">"$.session_id"</input>
           <input name="outputType">"default"</input>
        </process>
        <log> "session_id from credential offer setup:" || $sessionID</log>
        <process handler="JsonPathProcessor" operation="process" output="qrCodeBase64" stopOnError="true">
           <input name="content">$credentialOfferResponse</input>
           <input name="expression">"$.base64_img"</input>
           <input name="outputType">"default"</input>
        </process>
        <log>"base64_img from credential offer setup:" || $qrCodeBase64</log>
        <process handler="Base64Processor" operation="decode" output="qrCodeImg" stopOnError="true">
            <input name="input">$qrCodeBase64</input>
        </process>

        <!--Display Credential Offer QrCode-->
        <interact inputTitle="Scan the QR Code" desc="Scan the QR Code with your wallet." with="wallet" stopOnError="true" >
            <instruct desc="Click on the magnifying glass to display the QR code"/>
            <instruct desc="Scan this QR with your wallet" mimeType="image/png">$qrCodeImg</instruct> <!--contentType="BASE64" -->
            <instruct desc="After issuing the PID in your wallet or if issuance fails, click on the Close button to continue"/>
        </interact>

        <!--Making an HTTP Request to the Issuer to retrieve sessionID logs to check Credential Offer success-->
        <assign to="attempt" type="number">1</assign>
        <assign to="maxAttempts" type="number">$DOMAIN{maxAttempts}</assign>
        <assign to="logsResponse">'none'</assign>
        <assign to="successful" type="string">"false"</assign>

        <log>"Retrieving logs at: " || $credentialIssuanceLogsURL || "?session_id=" || $sessionID</log>
        <while title="HTTP Call Loop to the Issuer" desc="Make HTTP calls until successful Credential Offer or timeout" stopOnError="true">
            <cond><![CDATA[$attempt <= $maxAttempts and $successful != "true"]]></cond>
            <do>
                <log>"Making HTTP request (attempt " || $attempt || ")..."</log>
                <send id="logsRequest" desc="Retrieve logs to check Credential Offer success" handler="HttpMessagingV2" from="simulatedCredentialOffer" to="issuer">
                    <input name="uri">$credentialIssuanceLogsURL || "?session_id=" || $sessionID</input>
                    <input name="method">"GET"</input>
                    <input name="headers">$httpHeaders</input>
                </send>
                <assign to="logsResponse" type="string">$logsRequest{response}{body}</assign>
                <process handler="JsonPathProcessor" operation="process" output="successfulResponse">
                   <input name="content">$logsResponse</input>
                   <input name="expression">"$.successful"</input>
                   <input name="outputType">"default"</input>
                </process>
                <assign to="successful" type="string">$successfulResponse</assign>
                <log>"Was Credential Offer successful? " || $successful</log>
                <assign to="attempt" type="number">$attempt + 1</assign>
                <process handler="DelayProcessor" operation="delay" input="$DOMAIN{delayBetweenCalls}"/>
            </do>
        </while>
                
        <verify handler="ExpressionValidator" desc="Verify http status code of the credential issuance logs request" stopOnError="true">
            <input name="expression">$logsRequest{response}{status} = "200"</input>
            <input name="successMessage">"The received http status code was 200."</input>
            <input name="failureMessage">"The received http status code was not 200."</input>
        </verify>
        <verify handler="ExpressionValidator" desc="Verify success of the credential issuance from logs response" stopOnError="true">
            <input name="expression">$successful = "true"</input>
            <input name="successMessage">"Credential Issuance was successful."</input>
            <input name="failureMessage">"Credential Issuance failed."</input>
        </verify>


        <!--Process Logs response-->
        <process handler="JsonPathProcessor" operation="process" output="count" stopOnError="true">
           <input name="content">$logsResponse</input>
           <input name="expression">"$.count"</input>
           <input name="outputType">"default"</input>
        </process>
        <log>"count from credential issuance logs: " || $count</log>
        <process handler="JsonPointerProcessor" operation="process" output="logs" stopOnError="true">
            <input name="content">$logsResponse</input>
            <input name="pointer">"/logs"</input>
        </process>
        <log>"Logs: " || $logs</log>
        
        <verify handler="$DOMAIN{issuerValidationService}" desc="Validate logs from the issuer logs response" >
            <input name="text">$logsResponse</input>
        </verify>

        <interact id="review" desc="Confirm wallet response">
            <request desc="Did wallet showed a warning regarding untrusted issuer?"
                    name="outcome" inputType="SELECT_SINGLE" options="Yes,No" required="true" default="No"/>
        </interact>
        <if desc="Did wallet showed a warning regarding untrusted issuer?">
            <cond>$review{outcome} = 'No'</cond>
            <then>
                <exit desc="Wallet has failed to pass the test"/>
            </then>
        </if>
    </steps>
    <output>
        <success>
            <default>"Test session succeeded."</default>
        </success>
        <failure>
            <default>"Test session failed. Refer to the failed step's report for more details."</default>
        </failure>
    </output>
</testcase>