<?xml version="1.0" encoding="UTF-8"?>
<testcase id="testCase1_documentRetrieval" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <gitb:name>Signing of a document retrieved from a relying party</gitb:name>
        <gitb:version>1.0</gitb:version>
        <gitb:description>This test case verifies that it is possible to retrieve a document requiring a signature from a relying party and sign it using the wallet. </gitb:description>
        <gitb:specification>
            <gitb:reference>Signature_DocumentRetrieval_1</gitb:reference>
        </gitb:specification>
        <gitb:documentation><![CDATA[
            <h4>Preconditions</h4>
            <ol style="list-style-type: lower-alpha;">
            <li>The user of the remote reader has shared its url to the wallet user</li>
            <li>The wallet has a valid PID</li>
            <li>The wallet has a signature functionality available</li>
            </ol>
            <h4>Test steps</h4>
            <ol>
            <li>The wallet user navigates to the url of the relying party</li>
            <li>The wallet user clicks on a link/scans a QR code to start document retrieval and signing</li>
            <li>The wallet user gives permission to sign the document received</li>
            </ol>
            <h4>Expected results</h4>
            <ol>
            <li>The website of the relying party opens</li>
            <li>The wallet opens and permission to sign the document is requested</li>
            <li>The wallet signs the document retrieved from the relying party</li>
            <li>The signed document is sent to the relying party</li>
            <li>The signed document is shown in the relying party</li>
            </ol>
        ]]></gitb:documentation>
    </metadata>

    <actors>
        <gitb:actor id="simulatedDocumentRetrieval" name="Simulated Document Retrieval" />
        <gitb:actor id="relyingParty" name="Relying Party" />
        <gitb:actor id="wallet" name="Wallet" role="SUT"/>
    </actors>

    <steps>
        <verify stopOnError="true" id="checkStatusCode" handler="ExpressionValidator" desc="Validate Document Retrieval URL" >
            <input name="expression">$DOMAIN{documentRetrievalURL} != ""</input>
            <input name="successMessage">"The Document Retrieval URL is defined."</input>
            <input name="failureMessage">"The Document Retrieval URL is not defined."</input>
        </verify>
        <verify stopOnError="true" id="checkStatusCode" handler="ExpressionValidator" desc="Validate Relying Party Logs URL" >
            <input name="expression">$DOMAIN{logsURL} != ""</input>
            <input name="successMessage">"The Relying Party Logs URL is defined."</input>
            <input name="failureMessage">"The Relying Party Logs URL is not defined."</input>
        </verify>

        <log>"Document Retrieval Request Object retrieved from: " || $DOMAIN{documentRetrievalURL}</log>
        
        <!--Making an HTTP Request to the Relying Party's Document Retrieval Endpoint -->
        <assign to="httpHeaders{Content-Type}">"application/json"</assign>
        <send stopOnError="true" id="documentRetrievalRequest" desc="Send Document Retrieval request to Relying Party" handler="HttpMessagingV2" from="simulatedDocumentRetrieval" to="relyingParty">
            <input name="uri">$DOMAIN{documentRetrievalURL}</input>
            <input name="method">"GET"</input>
            <input name="headers">$httpHeaders</input>
        </send>
        <verify stopOnError="true" id="checkStatusCode" handler="StringValidator" desc="Validate Document Retrieval Response HTTP status">
            <input name="actual">$documentRetrievalRequest{response}{status}</input>
            <input name="expected">"200"</input>
            <input name="successMessage">"The received Document Retrieval HTTP status was 200."</input>
            <input name="failureMessage">"The received Document Retrieval HTTP status was not 200."</input>
        </verify>
        <log>"Document Retrieval response status:" || $documentRetrievalRequest{response}{status}</log>

        <assign to="documentRetrievalResponse" source="$documentRetrievalRequest{response}{body}" type="string"/> <!--Covert binary to string-->
        <process stopOnError="true" handler="JsonPathProcessor" operation="process" output="transactionId"> <!--Extract transaction_id from response-->
           <input name="content">$documentRetrievalResponse</input>
           <input name="expression">"$.transaction_id"</input>
           <input name="outputType">"default"</input>
        </process>
        <log> "Document Retrieval response transaction id:" || $transactionId</log>
        <process stopOnError="true" handler="JsonPathProcessor" operation="process" output="base64Img"> <!--Extract base64_img from response-->
           <input name="content">$documentRetrievalResponse</input>
           <input name="expression">"$.qr_code"</input>
           <input name="outputType">"default"</input>
        </process>
        <log>"Document Retrieval response base64 image:" || $base64Img</log>

        <!--Display Document Retrieval QrCode-->
        <interact stopOnError="true" inputTitle="Scan the QR Code" desc="Scan the QR Code with your wallet." with="wallet">
            <instruct desc="Click on the magnifying glass to display the QR code"/>
            <instruct desc="Scan this QR with your wallet" contentType="BASE64" mimeType="image/png">$base64Img</instruct>
            <instruct desc="After signing the document with your wallet, click on the Close button to continue"/>
        </interact>

        <!--Making an HTTP Request to the Relying Party to retrieve the signed document received from the Wallet-->
        <log>"Retrieving signed document at: " || $DOMAIN{getSignedDocURL} || "/" || $transactionId</log>
        <assign to="attempt" type="number">1</assign>
        <assign to="maxAttempts" type="number">$DOMAIN{maxAttempts}</assign>
        <assign to="signedDocStatus">'404'</assign>
        <assign to="signedDocResponse">'none'</assign>

        <while stopOnError="true" title="HTTP Call Loop to the Relying Party" desc="Make HTTP calls until successful signed document is received or timeout">
            <cond><![CDATA[$attempt <= $maxAttempts and $signedDocStatus != '200']]></cond>
            <do>
                <log>"Making HTTP request (attempt " || $attempt || ")..."</log>
                <send id="signedDocResponse" desc="Retrieve signed document" handler="HttpMessagingV2" from="simulatedDocumentRetrieval" to="relyingParty">
                    <input name="uri">$DOMAIN{getSignedDocURL} || "/" || $transactionId</input>
                    <input name="method">"GET"</input>
                    <input name="headers">$httpHeaders</input>
                </send>
                <assign to="signedDocStatus" type="string">$signedDocResponse{response}{status}</assign>
                <assign to="attempt" type="number">$attempt + 1</assign>
                <process handler="DelayProcessor" operation="delay" input="$DOMAIN{delayBetweenCalls}"/>
            </do>
        </while>        
        <verify stopOnError="true" id="checkSignedDocStatusCode" handler="StringValidator" desc="Validate the HTTP status of the signed document retrieval request">
            <input name="actual">$signedDocStatus</input>
            <input name="expected">"200"</input>
            <input name="failureMessage">"The received HTTP status was not 200."</input>
        </verify>
        <log>"Logs Retrieval status:" || $signedDocStatus</log>
        <log>"Logs Retrieval body:" || $signedDocResponse{response}{body}</log>

        <!--Retrieve Logs Response-->

        <send id="signatureLogs" desc="Retrieve signature logs" handler="HttpMessagingV2" from="simulatedDocumentRetrieval" to="relyingParty">
            <input name="uri">$DOMAIN{logsURL} || "/"  || $transactionId</input>
            <input name="method">"GET"</input>
        </send>
        <verify stopOnError="true" id="checkSignatureLogsStatusCode" handler="StringValidator" desc="Validate the HTTP status of the signature logs retrieval request">
            <input name="actual">$signatureLogs{response}{status}</input>
            <input name="expected">"200"</input>
            <input name="failureMessage">"The received HTTP status was not 200."</input>
        </verify>
        <log>$signatureLogs{response}{body}</log>
    </steps>
    <output>
        <success>
            <default>"Test session succeeded."</default>
        </success>
        <failure>
            <default>"Test session failed. Refer to the failed step's report for more details."</default>
        </failure>
    </output>
</testcase>